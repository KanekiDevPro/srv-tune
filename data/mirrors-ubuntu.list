# Ubuntu archive mirrors benchmarked live with curl timing.
# Format per line: <url> <label> owner=<owner-name> docs=<docs-url> verified=<status>
# verified=pending blocks release (see tests/pre-publish.sh); only the
# maintainer flips it to verified after manual review. Never set it yourself.
# NOTE: apt entries are http by distro convention (apt verifies via Release
# signatures); the HTTPS-only rule applies to pip/npm/docker registry lists.
# SPDX-License-Identifier: MIT
http://archive.ubuntu.com/ubuntu/ ubuntu-main owner=Canonical docs=https://launchpad.net/ubuntu/+archivemirrors verified=pending
http://ir.archive.ubuntu.com/ubuntu/ ubuntu-ir owner=Canonical docs=https://launchpad.net/ubuntu/+archivemirrors verified=pending
http://mirror.hetzner.com/ubuntu/ hetzner owner=Hetzner docs=https://mirror.hetzner.com verified=pending
