# Ubuntu archive mirrors benchmarked live with curl timing.
# Schema per line:
#   <url> <id> kind=apt owner=<owner> docs=<docs-url> tier=default verified=<status>
# verified=pending blocks use (see docs/DATA-REVIEW.md); only the maintainer
# flips it to verified after manual review. Never set it yourself.
# NOTE: apt entries are http by distro convention (apt verifies via Release
# signatures); the HTTPS-only rule applies to pip/npm/docker registry lists.
# SPDX-License-Identifier: MIT
http://archive.ubuntu.com/ubuntu/ ubuntu-main kind=apt owner=Canonical docs=https://launchpad.net/ubuntu/+archivemirrors tier=default verified=pending
http://ir.archive.ubuntu.com/ubuntu/ ubuntu-ir kind=apt owner=Canonical docs=https://launchpad.net/ubuntu/+archivemirrors tier=default verified=pending
http://mirror.hetzner.com/ubuntu/ hetzner kind=apt owner=Hetzner docs=https://mirror.hetzner.com tier=optional verified=pending
